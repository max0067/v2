# Configuration de l'application Flask
# Copiez ce fichier en .env et modifiez les valeurs selon votre environnement

# Environnement Flask (development, production, testing)
FLASK_ENV=development
FLASK_DEBUG=True

# Clé secrète pour les sessions (CHANGEZ CECI EN PRODUCTION!)
SECRET_KEY=votre-cle-secrete-tres-longue-et-aleatoire-ici

# Configuration de la base de données MySQL
DB_HOST=localhost
DB_NAME=dusselle_rss
DB_USER=root
DB_PASS=votre_mot_de_passe_mysql

# Port de l'application (optionnel, défaut: 5000)
PORT=5000

# Paramètres RSS
RSS_TIMEOUT=30
RSS_USER_AGENT=Veille Juridique RSS Bot/2.0

# Rétention des articles (en jours)
ARTICLES_RETENTION_DAYS=90
